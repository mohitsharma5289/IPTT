# Copy to .env for local development. Never commit a real secret.
ENVIRONMENT=local
DEBUG=false

DATABASE_URL=postgresql+psycopg://iptt:iptt@localhost:5432/iptt
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In OpenShift this comes from a Secret. Startup refuses the default outside local.
SESSION_SECRET=change-me-to-at-least-32-characters-of-random
SESSION_HTTPS_ONLY=true
ALLOW_SELF_REGISTRATION=false
PASSWORD_MIN_LENGTH=12

CORS_ORIGINS=["http://localhost:3000"]
MAX_UPLOAD_BYTES=10485760

LOG_LEVEL=INFO
LOG_JSON=true
